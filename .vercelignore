# Vercel stops reading .gitignore once a .vercelignore exists, so this file has
# to list everything itself. models/ and data/index/ are excluded by .gitignore
# but must be deployed: the first holds the 23 MB ONNX weights (a read-only
# serverless filesystem cannot download them at runtime), the second holds the
# prebuilt index. next.config.ts bundles both via outputFileTracingIncludes.
node_modules
.next
.git
.cache
coverage
corpus-*
docs/screenshots
tests
*.log
*.sse
.env
