# local demo corpora (not for the public repo yet)

# Local test corpora crawled from third-party websites, and the golden and
# probe sets built from them. They contain other people's published text and
# contact details, so they stay out of this public repository. The bundled
# corpus/ is public-domain prose for that reason.
corpus-*/
!corpus/
scripts/golden-*.ts
scripts/probes-*.ts
scripts/calibration-*.ts
answers-*.txt
prod-*.txt
final-*.txt
sweep*.txt
cmp-*.txt
v2-*.txt
v3-*.txt
cross-vertical.txt

# local model weights (shipped to deploys via .vercelignore, not to git)
models/

.vercel

# local answer transcripts and scratch probes
answers-*.txt
cmp-*.txt
cross-vertical.txt
sweep*.txt
final-review*.txt
v2-*.txt
prod-*.txt
*.sse
*.log
